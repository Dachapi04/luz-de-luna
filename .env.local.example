# Copia este archivo a .env.local y llena los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

# --- Firebase client SDK ---------------------------------------------------
# Consola de Firebase > Configuración del proyecto > Tus apps > SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin SDK (solo servidor, usado en app/api/**) --------------
# Consola de Firebase > Configuración del proyecto > Cuentas de servicio
# > Generar nueva clave privada. Copia los 3 valores del JSON descargado.
# IMPORTANTE: FIREBASE_ADMIN_PRIVATE_KEY debe ir entre comillas dobles y
# con los saltos de línea como \n (así es como viene en el JSON original).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Dominio interno usado para construir el correo ficticio de Auth ------
# usuario "juan" -> juan@luzdeluna.local (no necesita ser un dominio real)
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=luzdeluna.local
